pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.whl_mods(
    additive_build_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")
cc_library(
    name = "numpy_headers",
    hdrs = glob(["site-packages/numpy/_core/include/**/*.h"]) + glob(["site-packages/numpy/core/include/**/*.h"]),
    includes = ["site-packages/numpy/_core/include", "site-packages/numpy/core/include"],
)
""",
    hub_name = "xprof_pypi_mods",
    whl_name = "numpy",
)
[
    pip.parse(
        experimental_requirement_cycles = {
            "fsspec": [
                "fsspec",
                "gcsfs",
            ],
        },
        extra_hub_aliases = {
            "numpy": ["numpy_headers"],
        },
        hub_name = "xprof_pypi",
        python_version = python_version,
        requirements_lock = "//:requirements_lock_{}.txt".format(python_version.replace(".", "_")),
        whl_modifications = {
            "@xprof_pypi_mods//:numpy.json": "numpy",
        },
    )
    for python_version in [
        "3.10",
        "3.11",
        "3.12",
        "3.13",
    ]
]
use_repo(pip, "xprof_pypi_mods", pypi = "xprof_pypi")
override_repo(
    pip,
    rules_ml_toolchain_pypi = "pypi",
    xla_pypi = "pypi",
)

