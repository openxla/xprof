{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "xprof": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "inlineStyle": false,
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": ".",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/xprof",
            "index": "index.html",
            "main": "main.ts",
            "preserveSymlinks": false,
            "polyfills": "zone.js",
            "tsConfig": "tsconfig.app.json",
            "stylePreprocessorOptions": {
              "includePaths": [
                "../"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "app/components/trace_viewer_v2/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                }
              ],
              "outputHashing": "none",
              "extractLicenses": true,
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "xprof:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "xprof:build:production"
            },
            "development": {
              "buildTarget": "xprof:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
