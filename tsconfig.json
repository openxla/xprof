{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "lib": ["dom", "es2022", "dom.iterable"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": false,
    "inlineSourceMap": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "paths": {
      "org_xprof/*": ["*"],
      "google3/third_party/xprof/*": ["*"],
      "@angular/*": ["node_modules/@angular/*"],
      "@ngrx/*": ["node_modules/@ngrx/*"],
      "rxjs": ["node_modules/rxjs"]
    },
    "types": ["node"]
  }
}

